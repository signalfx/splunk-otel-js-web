<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Resource observer test</title>
  <%- renderAgent() %>
</head>
<body>
  <h1>Resource observer test</h1>
  <img src="assets/image.png?noCache=true" alt="no-cache">

  <script>
    function loadScript() {
      const p = new Promise(function(resolve, _) {
		  const s = document.createElement( 'script' );
        s.setAttribute( 'src', 'assets/test.js' );
        s.onload = function() {
          console.log('script resolved', performance.now());
          resolve();
        };
        document.body.appendChild(s);
        console.log('script load end', performance.now());
      });
      return p;
    }

    function loadImg() {
      console.log('image load start', performance.now());
		const p = new Promise(function(resolve, _) {
			const img = document.createElement('img');
        img.src = 'assets/splunk-black.svg?delay=100';
        img.onload = function() {
          console.log('image resolved', performance.now());
          resolve();
        };
        document.body.appendChild(img);
        console.log('load img end ', performance.now())
      });
      return p;
    }

    function loadStylesheetWithFont() {
      const p = new Promise(function(resolve, reject) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'assets/css-font-img.css?postload=true';
        link.onload = function() {
          const fontText = document.createElement('span');
          fontText.textContent = 'postload font';
          document.body.appendChild(fontText);

          if (document.fonts && document.fonts.load) {
            document.fonts.load('16px splunkerz').then(resolve, reject);
            return;
          }

          resolve();
        };
        link.onerror = reject;
        document.head.appendChild(link);
      });
      return p;
    }

    function loadMedia(type) {
      const p = new Promise(function(resolve) {
        const media = document.createElement(type);
        media.preload = 'auto';
        media.src = 'assets/image.png?media=' + type;
        media.onloadeddata = resolve;
        media.onerror = resolve;
        document.body.appendChild(media);
      });
      return p;
    }

    window.testing = true;
    window.addEventListener("load", function(e) {
	  if (!e.isTrusted) {
	  	return
	  }

	  // Dispatch load event to check that resources are not reported more than once
	  dispatchEvent(new Event('load'));

      console.log('test doc-load', performance.now())
      Promise.all([loadImg(), loadScript(), loadStylesheetWithFont(), loadMedia('audio'), loadMedia('video')]).then(function() {
        console.log('test promise-all', performance.now())
        SplunkRum.provider.getTracer('default').startSpan('guard-span').end();
        window.testing = false;
      })
    })
  </script>

</body>
</html>
